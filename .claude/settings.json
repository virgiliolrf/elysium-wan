{
  "permissions": {
    "allow": [
      "Bash(node agents-architetura/tools/wf/build.mjs:*)",
      "Bash(node agents-architetura/tools/gates/ladder.mjs:*)",
      "Bash(node agents-architetura/tools/gates/bench-gate.mjs:*)",
      "Bash(node --test:*)",
      "Bash(uv:*)",
      "Bash(uvx pip-audit:*)",
      "Bash(cargo:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(test -e:*)",
      "Bash(node agents-architetura/tools/factory/approve.mjs check:*)",
      "Bash(node agents-architetura/tools/factory/approve.mjs pending:*)",
      "Bash(node agents-architetura/tools/factory/freeze.mjs check:*)",
